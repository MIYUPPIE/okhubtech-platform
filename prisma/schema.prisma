generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  INSTRUCTOR
  PARTNER
  STUDENT
  PUBLIC
}

enum TrackLevel {
  FOUNDATION
  BUILDER
  INNOVATOR
  LEADER
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProductType {
  BOOK
  ROBOTICS_KIT
  IOT_COMPONENT
  AUTOMATION_TOOL
  DIGITAL
}

enum OrderStatus {
  DRAFT
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  STRIPE
  MANUAL
}

enum PartnerType {
  SCHOOL
  NGO
  GOVERNMENT
  CORPORATE
}

enum ContactType {
  PARTNER
  ENROLL
  SUPPORT
}

enum ResearchStatus {
  IDEA
  ACTIVE
  COMPLETED
  ARCHIVED
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  password       String?
  image          String?
  emailVerified  DateTime?
  phone          String?
  organization   String?
  bio            String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  roles          Role[]
  enrollments    Enrollment[]
  orders         Order[]
  contactForms   ContactSubmission[]
  researchLeads  Research[]     @relation("ResearchLead")
  sessions       Session[]
  accounts       Account[]
}

model Role {
  id          String    @id @default(cuid())
  name        RoleName  @unique
  description String?
  users       User[]
  createdAt   DateTime  @default(now())
}

model Program {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String?
  description    String?
  featuredImage  String?
  isPaid         Boolean       @default(false)
  price          Decimal?      @db.Decimal(10, 2)
  currency       String        @default("USD")
  durationWeeks  Int?
  published      Boolean       @default(false)
  tracks         Track[]
  courses        Course[]
  projects       Project[]
  enrollments    Enrollment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Track {
  id          String      @id @default(cuid())
  name        String
  level       TrackLevel
  description String?
  order       Int         @default(0)
  program     Program     @relation(fields: [programId], references: [id])
  programId   String
  courses     Course[]
  enrollments Enrollment[]
  createdAt   DateTime    @default(now())
}

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  duration    String?
  modality    String?
  track       Track    @relation(fields: [trackId], references: [id])
  trackId     String
  program     Program? @relation(fields: [programId], references: [id])
  programId   String?
  projects    Project[]
  createdAt   DateTime @default(now())
}

model Project {
  id             String     @id @default(cuid())
  title          String
  description    String?
  mandatory      Boolean    @default(true)
  repositoryUrl  String?
  artifactUrl    String?
  program        Program    @relation(fields: [programId], references: [id])
  programId      String
  course         Course?    @relation(fields: [courseId], references: [id])
  courseId       String?
  enrollments    Enrollment[]
  createdAt      DateTime   @default(now())
}

model Enrollment {
  id                String           @id @default(cuid())
  status            EnrollmentStatus @default(PENDING)
  accessType        String           @default("free")
  isPaid            Boolean          @default(false)
  projectSubmitted  Boolean          @default(false)
  projectUrl        String?
  cohortLabel       String?
  metadata          Json?
  user              User             @relation(fields: [userId], references: [id])
  userId            String
  program           Program          @relation(fields: [programId], references: [id])
  programId         String
  track             Track?           @relation(fields: [trackId], references: [id])
  trackId           String?
  project           Project?         @relation(fields: [projectId], references: [id])
  projectId         String?
  order             Order?           @relation(fields: [orderId], references: [id])
  orderId           String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model SolutionCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  industry    String
  description String?
  solutions   Solution[]
}

model Solution {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  industry         String
  problem          String
  technologyStack  String
  deploymentStatus String
  impactSummary    String
  metrics          Json?
  category         SolutionCategory  @relation(fields: [categoryId], references: [id])
  categoryId       String
  partners         Partner[]         @relation("SolutionPartners")
  createdAt        DateTime          @default(now())
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String?
  type        ProductType
  price       Decimal     @db.Decimal(10, 2)
  currency    String      @default("USD")
  inventory   Int         @default(0)
  featured    Boolean     @default(false)
  mediaUrl    String?
  specs       Json?
  active      Boolean     @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  status        OrderStatus   @default(DRAFT)
  totalAmount   Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  notes         String?
  user          User?         @relation(fields: [userId], references: [id])
  userId        String?
  enrollment    Enrollment?
  items         OrderItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
}

model Payment {
  id           String          @id @default(cuid())
  provider     PaymentProvider @default(PAYSTACK)
  status       PaymentStatus   @default(INITIATED)
  reference    String          @unique
  amount       Decimal         @db.Decimal(10, 2)
  currency     String          @default("USD")
  payload      Json?
  order        Order           @relation(fields: [orderId], references: [id])
  orderId      String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Research {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  summary       String?
  status        ResearchStatus  @default(ACTIVE)
  focusArea     String?
  lead          User?           @relation("ResearchLead", fields: [leadId], references: [id])
  leadId        String?
  collaborators Partner[]       @relation("ResearchPartners")
  publications  Publication[]
  prototypes    Json?
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Publication {
  id           String    @id @default(cuid())
  title        String
  excerpt      String?
  documentUrl  String
  thumbnailUrl String?
  publishedAt  DateTime?
  research     Research? @relation(fields: [researchId], references: [id])
  researchId   String?
  createdAt    DateTime  @default(now())
}

model Partner {
  id              String      @id @default(cuid())
  name            String
  classification  PartnerType
  description     String?
  website         String?
  email           String?
  phone           String?
  region          String?
  solutions       Solution[]   @relation("SolutionPartners")
  research        Research[]   @relation("ResearchPartners")
  collaborationRequests ContactSubmission[]
  createdAt       DateTime     @default(now())
}

model ImpactMetric {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  value     Int      @default(0)
  unit      String?  @default("count")
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id            String      @id @default(cuid())
  type          ContactType
  name          String
  email         String
  organization  String?
  phone         String?
  message       String?
  metadata      Json?
  resolved      Boolean     @default(false)
  resolvedAt    DateTime?
  user          User?       @relation(fields: [userId], references: [id])
  userId        String?
  partner       Partner?    @relation(fields: [partnerId], references: [id])
  partnerId     String?
  createdAt     DateTime    @default(now())
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
